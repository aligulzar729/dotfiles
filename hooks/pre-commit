#!/usr/bin/env bash
#
# Scans staged content for secrets and PII. .gitignore matches paths, which
# keeps passing after an upstream rename or a `git add -f`, so this reads the
# bytes instead. A heuristic, not a boundary. Override: git commit --no-verify.
# Wired up by the link step via core.hooksPath.

set -uo pipefail

root="$(git rev-parse --show-toplevel)"

if ! git diff --cached -U0 | awk -v allow_file="$root/.pii-allow" -f "$root/lib/scan.awk"; then
  {
    printf '  commit blocked.\n'
    printf '  False positive? Add "pii-ok" to that line, or a regex to .pii-allow.\n'
    printf '  Override once: git commit --no-verify\n\n'
  } >&2
  exit 1
fi

# Copy to ~/.zshrc.local. Never committed. Secrets and per-machine paths only.
#
# Anything here runs on every shell start, so keep it short. If you find
# yourself adding a toolchain you use daily on every machine, it belongs in
# home/.zshrc instead.

# export DOTFILES_DIR="$HOME/code/dotfiles"
# export EDITOR="zed --wait"

# Secrets. Prefer the keychain over plaintext:
#   security add-generic-password -a "$USER" -s ANTHROPIC_API_KEY -w
# export ANTHROPIC_API_KEY="$(security find-generic-password -a "$USER" -s ANTHROPIC_API_KEY -w)"

# Laravel Herd, macOS only. NVM_DIR is read by the omz nvm plugin, which
# home/.zshrc loads lazily, so setting it here costs nothing at startup.
# export HERD_PHP_84_INI_SCAN_DIR="$HOME/Library/Application Support/Herd/config/php/84/"
# export NVM_DIR="$HOME/Library/Application Support/Herd/config/nvm"
# export PATH="$HOME/Library/Application Support/Herd/bin/:$PATH"
# source "/Applications/Herd.app/Contents/Resources/config/shell/zshrc.zsh"

# Extra PATH entries, one line each.
# export PATH="$HOME/.cargo/bin:$HOME/.bun/bin:$HOME/go/bin:$PATH"

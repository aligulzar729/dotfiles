# Ghostty. Symlinked from the dotfiles repo. Ghostty reads this XDG path on
# macOS too, so do not also link it into Application Support: both paths get
# loaded, the config-file include below runs twice, and Ghostty reports
# "cycle detected".
# The macos-* keys are accepted and ignored on Linux, so one file covers both.
# Reference: ghostty +show-config --default --docs

# Theme
theme = Catppuccin Mocha

# Font
font-family = JetBrainsMonoNL Nerd Font Mono
font-feature = -dlig
font-size = 14

font-style-bold = false
font-style-italic = false
font-style-bold-italic = false

font-thicken = true
font-thicken-strength = 1

alpha-blending = linear

adjust-cell-width = -1
adjust-cell-height = 2

# Window
window-padding-x = 10
window-padding-y = 10
window-padding-balance = true
background-opacity = 0.9
resize-overlay = never

# macOS only
macos-titlebar-style = tabs
macos-window-shadow = false
macos-option-as-alt = true

# Cursor
cursor-style = block
cursor-style-blink = false
cursor-invert-fg-bg = true
cursor-opacity = 0.8
mouse-hide-while-typing = true

# Shell
shell-integration = zsh
shell-integration-features = no-cursor

# Keybinds. Alt/Cmd to the start and end of the line, alt-arrow by word.
keybind = alt+h=text:\x01
keybind = alt+l=text:\x05
keybind = cmd+left=text:\x01
keybind = cmd+right=text:\x05
keybind = alt+left=esc:b
keybind = alt+right=esc:f

# Machine-local overrides (optional; absent on other machines).
config-file = ?~/.config/ghostty/config.local

# Starter ~/.ssh/config. The `ssh` install step copies this when you have none,
# and adds the include line when you already do. Nothing here is secret.
#
# The real content lives in ~/.ssh/config.d/:
#   00-agent.conf     generated per machine, points ssh at Bitwarden's agent
#   10-*.conf         YOUR SERVERS — keep in a private repo, this one is public
#   99-defaults.conf  symlink to home/.ssh/config.d/99-defaults.conf in this repo
#
# ssh is FIRST-match-wins, so the include stays above any Host block.

Include ~/.ssh/config.d/*.conf

# OrbStack's 'orb' host. Harmless if OrbStack is not installed.
Include ~/.orbstack/ssh/config

# ── Template for ~/.ssh/config.d/10-servers.conf in the private repo ───────
# Host myserver
#	HostName 203.0.113.10
#	User ali
#	Port 22
#
# Host internal-box
#	HostName 10.0.0.5
#	User ali
#	ProxyJump myserver
#
# IdentityFile is deliberately absent: Bitwarden's agent offers the key, so
# there is no key file to point at. Add IdentityFile + IdentitiesOnly yes only
# for a host that must use one specific on-disk key.

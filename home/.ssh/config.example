# SSH host config. Copy to ~/.ssh/config, then it works everywhere ssh does:
# terminal, git, rsync, scp, VS Code Remote, Termius (it reads this file too).
#
#   cp ~/Projects/dotfiles/home/.ssh/config.example ~/.ssh/config
#   chmod 600 ~/.ssh/config
#
# Hostnames/IPs are not secret like keys are, but if this repo is ever public,
# keep real servers out of it: leave the real ~/.ssh/config local, or move it
# to a private repo. Private keys never belong here (see .gitignore).

# ── Defaults for every host ────────────────────────────────────────────────
Host *
	AddKeysToAgent yes
	ServerAliveInterval 60
	# Serve keys from a password-manager agent instead of files on disk.
	# 1Password:  IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
	# KeePassXC/Strongbox expose their own agent socket; point IdentityAgent at it.
	# IdentityAgent "~/.1password/agent.sock"

# ── Your git server (you already have the key: ~/.ssh/hub-devlab) ──────────
Host hub.devlab.jp
	User git
	IdentityFile ~/.ssh/hub-devlab
	IdentitiesOnly yes

# ── Template: copy per server ──────────────────────────────────────────────
# Host myserver
#	HostName 203.0.113.10
#	User ali
#	Port 22
#	IdentityFile ~/.ssh/id_ed25519
#	IdentitiesOnly yes

# ── Jump host example ──────────────────────────────────────────────────────
# Host internal-box
#	HostName 10.0.0.5
#	User ali
#	ProxyJump myserver

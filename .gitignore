*.bak
.zshrc.local
.DS_Store
*.log

# Never commit private keys, even by accident. Public keys and config are fine.
id_*
!id_*.pub
*.pem
*.key
*_rsa
*_ed25519
*_ecdsa
home/.ssh/config
!home/.ssh/config.example

# Zed runtime state, not config
home/.config/zed/prompts/
home/.config/zed/conversations/
home/.config/zed/backup-*/
home/.config/zed/settings_backup.json

# ani-cli self-updates (ani-cli -U), so tracking it just churns. The installer
# fetches the latest instead. ani-skip has no self-update and stays vendored.
home/.local/bin/ani-cli
